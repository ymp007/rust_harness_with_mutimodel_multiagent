# Copy to .env in the project. Never commit or paste your real key into chat.
# Explicit environment variables override .env settings.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o-mini
# Overall deadline for a provider request. Streaming also applies a 120s
# per-read idle timeout, so a slow generation is not truncated mid-answer.
OPENROUTER_TIMEOUT_SECS=300
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=Y Code

# Enables POST /api/turn on the experimental daemon dashboard.
# Unset: the endpoint returns 503 and spends no credits.
# Set: callers must send "Authorization: Bearer <value>".
# Any local process can reach 127.0.0.1:4040, so treat this as required.
#Y_DAEMON_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING